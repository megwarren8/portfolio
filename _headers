# Cloudflare Pages reads this file. Before it existed the site ran on Pages
# defaults: nosniff and a referrer policy, but no frame or permissions policy,
# and every asset on a four-hour revalidate.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Font files, committed once and never rebuilt. Declared in cache-exempt.txt
# with the reason, because their names carry no hash. Everything else
# (pages, CSS, images) stays on the Pages default revalidate, so a changed
# file under an unchanged name can never be stuck at the edge for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
