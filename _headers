# Cloudflare Pages reads this file. HSTS and the content security policy
# were added 10-30 (call sheet Q5): the site serves one script of its own
# (theme.js) and nothing from any other origin, so the policy can be strict.
# style-src keeps 'unsafe-inline' for the Canvas sample's inline styles.
# connect-src is 'self', not 'none': the site makes no requests of its own,
# but 'none' blocked Lighthouse's same-origin robots.txt fetch (10-31). Before it existed the site ran on Pages
# defaults: nosniff and a referrer policy, but no frame or permissions policy,
# and every asset on a four-hour revalidate.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'

# The sample Lesson Studio (teacher-demo kit, 11-01, Megan's card E1) is the real Studio app, one self-contained
# file: inline scripts and styles, fonts and images as data: URIs, KaTeX unpacked from an embedded gzip with
# new Function, slide decks saved through blob: downloads, games in srcdoc frames. It needs that much, and only
# it gets it: "!" drops the site policy for this one path before the looser one is set. It still loads nothing
# from any other origin.
/teacher-demo/lesson-studio*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'

# Font files, committed once and never rebuilt. Declared in cache-exempt.txt
# with the reason, because their names carry no hash. Everything else
# (pages, CSS, images) stays on the Pages default revalidate, so a changed
# file under an unchanged name can never be stuck at the edge for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
